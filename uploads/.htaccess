# Prevent PHP and script execution inside uploads directory
<FilesMatch "(?i)\.(php|php3|php4|php5|phtml|phar|inc|pl|py|cgi|sh|bash|exe|bat|cmd|com)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
