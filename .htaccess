# Priority Directory Index (Prioritize index.php over hacker dropped index.html)
DirectoryIndex index.php index.html

# Prevent Directory Browsing
Options -Indexes

# Block access to sensitive and backup files
<FilesMatch "(^\.|\.(bak|config|sql|ini|log|sh|inc|swp|dist|sample)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

RewriteEngine On

# ----------------------------------------------------------------------
# 1. FIX REPEATING /services/.../services/... LOOPS
# ----------------------------------------------------------------------
RewriteRule ^services/[^/]+/services/([^/]+)/?$ /services/$1/ [R=301,L]
RewriteRule ^services/[^/]+/services/?$ /services/ [R=301,L]

# ----------------------------------------------------------------------
# 2. COURSES CLEAN REDIRECTS (Old /courses/ subfolder -> live root pages)
# ----------------------------------------------------------------------
RewriteRule ^courses/?$ /#courses [R=301,L]
RewriteRule ^courses/ecommerce-marketing-course\.php$ /services/ecommerce-marketing.php [R=301,L]
RewriteRule ^courses/meta-ads-facebook-course\.php$ /meta-ads-facebook-ads-course.php [R=301,L]
RewriteRule ^courses/digital-marketing-ai-course\.php$ /digital-marketing-with-ai-course.php [R=301,L]
RewriteRule ^courses/wordpress-website-course\.php$ /wordpress-website-design-course.php [R=301,L]
RewriteRule ^courses/performance-marketing-course\.php$ /ppc-google-ads-course.php [R=301,L]
RewriteRule ^courses/([a-z0-9-]+)\.php$ /$1.php [R=301,L]
RewriteRule ^courses/([a-z0-9-]+)/?$ /$1.php [R=301,L]

# ----------------------------------------------------------------------
# 3. TYPOS & OLD DIRECT ROOT PHP FILES
# ----------------------------------------------------------------------
RewriteRule ^terms-and-conditions\.php$ /terms-conditions.php [R=301,L]
RewriteRule ^ios-app-development\.php$ /services/ios-app-development/ [R=301,L]
RewriteRule ^android-app-development\.php$ /services/android-app-development/ [R=301,L]
RewriteRule ^digital-marketing-agency-([a-z0-9-]+)\.php$ /services/digital-marketing/ [R=301,L]

# ----------------------------------------------------------------------
# 4. SERVICES FOLDER EXTENSIONLESS CLEAN REDIRECTS
# ----------------------------------------------------------------------
RewriteRule ^services/digital-marketing\.php$ /services/digital-marketing/ [R=301,L]
RewriteRule ^services/seo\.php$ /services/seo-service/ [R=301,L]
RewriteRule ^services/social-media-marketing\.php$ /services/social-media-marketing/ [R=301,L]
RewriteRule ^services/ppc-marketing\.php$ /services/ppc-marketing/ [R=301,L]
RewriteRule ^services/google-ads\.php$ /services/google-ads/ [R=301,L]
RewriteRule ^services/facebook-instagram-ads\.php$ /services/facebook-instagram-ads/ [R=301,L]
RewriteRule ^services/youtube-ads\.php$ /services/youtube-ads/ [R=301,L]
RewriteRule ^services/website-designing\.php$ /services/website-designing/ [R=301,L]
RewriteRule ^services/website-development\.php$ /services/website-development/ [R=301,L]
RewriteRule ^services/wordpress-development\.php$ /services/wordpress-development/ [R=301,L]
RewriteRule ^services/e-commerce-website-development\.php$ /services/ecommerce-development/ [R=301,L]
RewriteRule ^services/shopify-website-development\.php$ /services/shopify-development/ [R=301,L]
RewriteRule ^services/mobile-app-development\.php$ /services/mobile-app-development/ [R=301,L]
RewriteRule ^services/android-app-development\.php$ /services/android-app-development/ [R=301,L]
RewriteRule ^services/ios-app-development\.php$ /services/ios-app-development/ [R=301,L]

# ----------------------------------------------------------------------
# 5. ROOT LANDING PAGE REDIRECTS
# ----------------------------------------------------------------------
RewriteRule ^mobile-app-development\.php$ /mobile-app-development-company-in-india/ [R=301,L]
RewriteRule ^website-design\.php$ /website-design-company-in-india/ [R=301,L]
RewriteRule ^software-development\.php$ /software-development-company-in-india/ [R=301,L]
RewriteRule ^mobile-app-development-india/?$ /mobile-app-development-company-in-india/ [R=301,L]
RewriteRule ^website-design-india/?$ /website-design-company-in-india/ [R=301,L]
RewriteRule ^software-development-india/?$ /software-development-company-in-india/ [R=301,L]

# ----------------------------------------------------------------------
# 6. LOCATION PAGES REWRITE RULE
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_URI} !^/mobile-app-development-company-in-india
RewriteCond %{REQUEST_URI} !^/website-design-company-in-india
RewriteCond %{REQUEST_URI} !^/software-development-company-in-india
RewriteCond %{REQUEST_URI} !^/services/
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_URI} !^/common/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z0-9-]+)/?$ service-location.php?slug=$1 [L,QSA]

# ----------------------------------------------------------------------
# 7. CUSTOM BRANDED 404 ERROR DOCUMENT
# ----------------------------------------------------------------------
ErrorDocument 404 /404.php

# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/eot
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching (mod_expires)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Media
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Webfonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # HTML
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ----------------------------------------------------------------------
# Cache-Control & Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
